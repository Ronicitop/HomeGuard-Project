# ==========================================================
# Variables de Entorno - HomeGuard IoT
# ==========================================================

# Base de Datos PostgreSQL (en Docker, el host es el nombre del servicio 'db')
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=homeguard_db

# Broker MQTT
# - Para broker local Mosquitto en Docker: mqtt://mqtt:1883
# - Para broker público en la nube: mqtt://broker.emqx.io:1883
MQTT_BROKER_URL=mqtt://mqtt:1883

# URL del frontend para validar solicitudes del navegador
PUBLIC_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INFERENCE_SECRET=
