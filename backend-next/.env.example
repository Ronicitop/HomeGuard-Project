# Copiar a .env.local y completar. Nunca versionar credenciales reales.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=homeguard
DB_PASS=REEMPLAZAR
DB_NAME=homeguard_db
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
# El broker local lee DB_* desde este archivo. Las credenciales de equipos
# se emiten en Conexiones y no se copian como MQTT_USERNAME del procesador.
# Iniciar.ps1 -Interfaz IP_PRIVADA habilita HG_MQTT_LAN_IP para el broker.
# scripts/setup-secrets.cjs genera usuario/password y HG_SECRET_KEY seguros.
MQTT_USERNAME=
MQTT_PASSWORD=
HG_SECRET_KEY=
HG_DEMO_MODE=true
HG_EMERGENCY_TRANSPORT=SIMULATED
HG_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
HG_PUSH_ENABLED=false
HG_EXPO_ACCESS_TOKEN=
# Flutter Android: archivo JSON de cuenta de servicio Firebase, solo en backend.
# Guardarlo en .local/ (ignorado por Git), nunca en la app ni en directorios públicos.
# Se requiere HG_PUSH_ENABLED=true y Firebase Cloud Messaging API habilitada.
# Sin credenciales válidas: FCM_NOT_CONFIGURED; no se envían alertas FCM.
# HG_FCM_SERVICE_ACCOUNT_FILE=../.local/firebase-service-account.json
HG_FCM_SERVICE_ACCOUNT_FILE=
HG_PIPER_PYTHON=
HG_PIPER_MODEL=
# Opcional: rutas locales. Sin publicar archivos privados por HTTP estático.
# HG_VOICE_CACHE=../.local/private-voice
# HG_PG_BIN=C:/Program Files/PostgreSQL/18/bin
