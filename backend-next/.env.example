# Copiar a .env.local y completar. Nunca versionar credenciales reales.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=homeguard
DB_PASS=REEMPLAZAR
DB_NAME=homeguard_db
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
# scripts/setup-secrets.cjs genera usuario/password y HG_SECRET_KEY seguros.
MQTT_USERNAME=
MQTT_PASSWORD=
HG_SECRET_KEY=
HG_DEMO_MODE=true
HG_EMERGENCY_TRANSPORT=SIMULATED
HG_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
HG_PUSH_ENABLED=false
HG_EXPO_ACCESS_TOKEN=
HG_PIPER_PYTHON=
HG_PIPER_MODEL=
# Opcional: rutas locales. Sin publicar archivos privados por HTTP estático.
# HG_VOICE_CACHE=../.local/private-voice
# HG_PG_BIN=C:/Program Files/PostgreSQL/18/bin
